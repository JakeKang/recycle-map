# Public application and authentication
NEXTAUTH_URL=https://your-service.invalid
NEXTAUTH_SECRET=replace-with-at-least-32-random-characters
ADMIN_USER_IDS=google:provider-account-id

# Supabase (service role is server-only)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=replace-with-public-anon-key
SUPABASE_SERVICE_ROLE_KEY=replace-with-server-only-service-role-key

# First key is active; keep old versions while old ciphertext exists.
# Generate each value with: openssl rand -base64 32
DATA_ENCRYPTION_KEYS=v1:replace-with-32-byte-base64-key

# Production upload and proxy boundary
UPLOAD_STORAGE_MODE=supabase
NEXT_PUBLIC_UPLOAD_STORAGE_MODE=supabase
TRUST_PROXY=true

# Production must keep these values.
ENABLE_TEST_ACCOUNTS=false
ALLOW_DEV_USER_HEADER=false
ALLOW_DB_FALLBACK_ON_ERROR=false
FORCE_LOCAL_STORE=false
